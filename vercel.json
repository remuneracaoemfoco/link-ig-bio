{
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bio1.remuneracaoemfoco.com.br"
        }
      ],
      "destination": "/classico/index.html"
    },
    {
      "source": "/img/:path*",
      "has": [
        {
          "type": "host",
          "value": "bio1.remuneracaoemfoco.com.br"
        }
      ],
      "destination": "/classico/img/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bio2.remuneracaoemfoco.com.br"
        }
      ],
      "destination": "/contraste/index.html"
    },
    {
      "source": "/img/:path*",
      "has": [
        {
          "type": "host",
          "value": "bio2.remuneracaoemfoco.com.br"
        }
      ],
      "destination": "/contraste/img/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bio3.remuneracaoemfoco.com.br"
        }
      ],
      "destination": "/fotos/index.html"
    },
    {
      "source": "/img/:path*",
      "has": [
        {
          "type": "host",
          "value": "bio3.remuneracaoemfoco.com.br"
        }
      ],
      "destination": "/fotos/img/:path*"
    },
    {
      "source": "/",
      "destination": "/fotos/index.html"
    },
    {
      "source": "/img/:path*",
      "destination": "/fotos/img/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}